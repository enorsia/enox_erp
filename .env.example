APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enox_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Ecom tracker only — separate Redis DB (not tied to CACHE_STORE)
TRACKER_REDIS_HOST=127.0.0.1
TRACKER_REDIS_PASSWORD=null
TRACKER_REDIS_PORT=6379
TRACKER_REDIS_DB=3
TRACKER_REDIS_PREFIX=enox:tracker:
TRACKER_REDIS_TTL_SECONDS=172800
TRACKER_REDIS_CONNECTION=tracker
TRACKER_QUEUE_CONNECTION=tracker
TRACKER_QUEUE_NAME=tracker
TRACKER_QUEUE_ASYNC=true
TRACKER_ANALYTICS_CACHE_ENABLED=true
TRACKER_ANALYTICS_CACHE_SECONDS=300
TRACKER_VISITOR_SEEN_TTL_SECONDS=31536000
TRACKER_ROLLUP_LOCK_SECONDS=45

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Ecom Tracker API (bcrypt hash — generate: php artisan tinker --execute="echo bcrypt('your-key');") ---
TRACKER_API_KEY_HASH=
TRACKER_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Ecom Tracker logging ---
# Master on/off. Daily files: storage/logs/ecom-tracker/ecom-tracker-YYYY-MM-DD.log
# Prefixes: [EcomTracker Frontend] storefront API | [EcomTracker Backend] ERP admin
TRACKER_LOGGING=true
TRACKER_LOG_CHANNEL=ecom_tracker
TRACKER_LOG_LEVEL=debug
TRACKER_LOG_DAYS=30

# --- Ecom Tracker sessions ---
TRACKER_SESSION_GAP_MINUTES=30
TRACKER_VISITOR_TIMEZONE=Europe/London

ADMIN_DEFAULT_NAME=Admin
ADMIN_DEFAULT_EMAIL=admin@gmail.com
SUPER_ADMIN_USERNAME=super@gmail.com
SUPER_ADMIN_PASSWORD=123456789
